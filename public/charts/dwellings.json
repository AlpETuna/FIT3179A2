{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Box area shows how many occupied homes of each type there were. Seven in ten Australian homes are separate houses. Caravans, cabins and other homes (under 1%) are left out.",
  "height": 316,
  "padding": 2,
  "autosize": "none",
  "signals": [
    {
      "name": "width",
      "init": "max(200, containerSize()[0] - 4)"
    }
  ],
  "data": [
    {
      "name": "tree",
      "url": "data/dwellings.json",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.category !== 'Other / not stated'"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "formula",
          "expr": "datum.count ? 0 : 1",
          "as": "children"
        },
        {
          "type": "treemap",
          "field": "count",
          "method": "squarify",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "paddingInner": 2,
          "paddingOuter": 2,
          "paddingTop": 22,
          "round": true
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.count > 0"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "count"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "parents",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "colour",
      "type": "ordinal",
      "domain": [
        "Separate house",
        "Townhouse",
        "Apartment",
        "Other / not stated"
      ],
      "range": [
        "#e4e1db",
        "#b3ada2",
        "#6b665d",
        "#ece9e4"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "stroke": {
            "value": "#fff"
          },
          "fill": {
            "scale": "colour",
            "field": "category"
          },
          "tooltip": {
            "signal": "{'Dwelling':datum.category,'Type':datum.name,'Homes':format(datum.count,',')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "parents"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 9"
          },
          "y": {
            "signal": "datum.y0 + 17"
          },
          "text": {
            "signal": "datum.x1 - datum.x0 > 60 && datum.children ? datum.name : ''"
          },
          "fontSize": {
            "value": 14
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#1d1d1d"
          },
          "limit": {
            "signal": "datum.x1-datum.x0-14"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + (width < 450 ? 3 : 7)"
          },
          "y": {
            "signal": "datum.y0 + 7"
          },
          "text": {
            "signal": "datum.x1 - datum.x0 > 38 && datum.y1 - datum.y0 > 48 ? (length(datum.label) ? [datum.label[0], datum.label[1], format(datum.count / datum.total, '.0%')] : format(datum.count / datum.total, '.0%')) : ''"
          },
          "baseline": {
            "value": "top"
          },
          "lineHeight": {
            "signal": "datum.x1 - datum.x0 > 200 ? 44 : 13"
          },
          "fontSize": {
            "signal": "datum.x1 - datum.x0 > 200 ? (width < 450 ? 28 : 40) : width < 450 ? 9.5 : 11.5"
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 4"
          },
          "fill": {
            "signal": "datum.category === 'Apartment' ? '#ffffff' : '#1d1d1d'"
          },
          "fontWeight": {
            "signal": "datum.x1 - datum.x0 > 200 ? 600 : 400"
          }
        }
      }
    }
  ],
  "config": {
    "text": {
      "font": "Libre Franklin"
    },
    "axis": {
      "labelFont": "Libre Franklin",
      "titleFont": "Libre Franklin"
    },
    "legend": {
      "labelFont": "Libre Franklin",
      "titleFont": "Libre Franklin"
    },
    "title": {
      "font": "Libre Franklin"
    }
  }
}
