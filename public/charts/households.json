  "scales": [
    {
      "name": "colour",
      "type": "ordinal",
      "domain": [
        "Family household",
        "One person",
        "Group household"
      ],
      "range": [
        "#386b62",
        "#a46931",
        "#655775"
      ]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "bands"
      },
      "encode": {
        "update": {
          "path": {
            "signal": "'M'+xLeft+','+(datum.a*plotHeight)+' C'+(width*.5)+','+(datum.a*plotHeight)+' '+(width*.5)+','+(datum.b*plotHeight)+' '+xRight+','+(datum.b*plotHeight)+' L'+xRight+','+((datum.b+datum.h)*plotHeight)+' C'+(width*.5)+','+((datum.b+datum.h)*plotHeight)+' '+(width*.5)+','+((datum.a+datum.h)*plotHeight)+' '+xLeft+','+((datum.a+datum.h)*plotHeight)+' Z'"
          },
          "fill": {
            "scale": "colour",
            "field": "household"
          },
          "fillOpacity": {
            "value": 0.65
          },
          "tooltip": {
            "signal": "{'Household':datum.household,'Dwelling':datum.dwelling,'Homes':format(datum.count,',')}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.side==='left'?xLeft-6:xRight"
          },
          "width": {
            "value": 6
          },
          "y": {
            "signal": "datum.start*plotHeight"
          },
          "y2": {
            "signal": "datum.end*plotHeight"
          },
          "fill": {
            "value": "#1d1d1d"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.side==='left'?xLeft-12:xRight+12"
          },
          "y": {
            "signal": "(datum.start+datum.end)/2*plotHeight"
          },
          "text": {
            "signal": "datum.name==='One person'?['One','person']:datum.name==='Family household'?['Family','household']:datum.name==='Group household'?['Group','household']:datum.name==='Separate house'?['Separate','house']:datum.name==='Other / not stated'?['Other /','not stated']:datum.name"
          },
          "fontSize": {
            "value": 13
          },
          "lineHeight": {
            "value": 15
          },
          "baseline": {
            "value": "middle"
          },
          "align": {
            "signal": "datum.side==='left'?'right':'left'"
          },
          "limit": {
            "signal": "width*.23-12"
          },
          "fill": {
            "value": "#1d1d1d"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans"
  },
  "description": "Bands connect household composition to dwelling type. Wider bands mean more households, not movement between homes. Other and unreported dwelling types are combined here."
}
