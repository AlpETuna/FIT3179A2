{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Each band links a type of household to the kind of home it lives in; wider bands mean more households. Four in five families live in a separate house, but one in four people living alone has an apartment.",
  "height": 320,
  "padding": 0,
  "autosize": "none",
  "signals": [
    {
      "name": "width",
      "init": "max(200, containerSize()[0] - 0)"
    },
    {
      "name": "xLeft",
      "update": "width*0.23"
    },
    {
      "name": "xRight",
      "update": "width*0.74"
    },
    {
      "name": "plotHeight",
      "update": "height-34"
    },
    {
      "name": "gap",
      "value": 0.035
    }
  ],
  "data": [
    {
      "name": "bands",
      "url": "data/households.json",
      "transform": [
        {
          "type": "formula",
          "expr": "indexof([\"Family household\", \"One person\", \"Group household\"], datum.household)",
          "as": "hOrder"
        },
        {
          "type": "formula",
          "expr": "indexof([\"Separate house\", \"Townhouse\", \"Apartment\", \"Other / not stated\"], datum.dwelling)",
          "as": "dOrder"
        },
        {
          "type": "filter",
          "expr": "datum.hOrder >= 0 && datum.dOrder >= 0"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "count"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.count / datum.total * (1 - 3 * gap)",
          "as": "h"
        },
        {
          "type": "window",
          "sort": {
            "field": [
              "hOrder",
              "dOrder"
            ]
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "h"
          ],
          "as": [
            "aEnd"
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "type": "formula",
          "expr": "datum.aEnd - datum.h + datum.hOrder * gap",
          "as": "a"
        },
        {
          "type": "window",
          "sort": {
            "field": [
              "dOrder",
              "hOrder"
            ]
          },
          "ops": [
            "sum"
          ],
          "fields": [
            "h"
          ],
          "as": [
            "bEnd"
          ],
          "frame": [
            null,
            0
          ]
        },
        {
          "type": "formula",
          "expr": "datum.bEnd - datum.h + datum.dOrder * gap",
          "as": "b"
        }
      ]
    },
    {
      "name": "leftNodes",
      "source": "bands",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.a + datum.h",
          "as": "aTo"
        },
        {
          "type": "aggregate",
          "groupby": [
            "household"
          ],
          "fields": [
            "a",
            "aTo"
          ],
          "ops": [
            "min",
            "max"
          ],
          "as": [
            "start",
            "end"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.household",
          "as": "name"
        },
        {
          "type": "formula",
          "expr": "'left'",
          "as": "side"
        }
      ]
    },
    {
      "name": "rightNodes",
      "source": "bands",
      "transform": [
        {
          "type": "formula",
          "expr": "datum.b + datum.h",
          "as": "bTo"
        },
        {
          "type": "aggregate",
          "groupby": [
            "dwelling"
          ],
          "fields": [
            "b",
            "bTo"
          ],
          "ops": [
            "min",
            "max"
          ],
          "as": [
            "start",
            "end"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.dwelling",
          "as": "name"
        },
        {
          "type": "formula",
          "expr": "'right'",
          "as": "side"
        }
      ]
    },
    {
      "name": "nodes",
      "source": [
        "leftNodes",
        "rightNodes"
      ]
    }
  ],
  "scales": [
    {
      "name": "colour",
      "type": "ordinal",
      "domain": [
        "Family household",
        "One person",
        "Group household"
      ],
      "range": [
        "#386b62",
        "#a46931",
        "#655775"
      ]
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "bands"
      },
      "encode": {
        "update": {
          "path": {
            "signal": "'M'+xLeft+','+(datum.a*plotHeight)+' C'+(width*.5)+','+(datum.a*plotHeight)+' '+(width*.5)+','+(datum.b*plotHeight)+' '+xRight+','+(datum.b*plotHeight)+' L'+xRight+','+((datum.b+datum.h)*plotHeight)+' C'+(width*.5)+','+((datum.b+datum.h)*plotHeight)+' '+(width*.5)+','+((datum.a+datum.h)*plotHeight)+' '+xLeft+','+((datum.a+datum.h)*plotHeight)+' Z'"
          },
          "fill": {
            "scale": "colour",
            "field": "household"
          },
          "fillOpacity": {
            "value": 0.65
          },
          "tooltip": {
            "signal": "{'Household':datum.household,'Dwelling':datum.dwelling,'Homes':format(datum.count,',')}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.side==='left'?xLeft-6:xRight"
          },
          "width": {
            "value": 6
          },
          "y": {
            "signal": "datum.start*plotHeight"
          },
          "y2": {
            "signal": "datum.end*plotHeight"
          },
          "fill": {
            "value": "#1d1d1d"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.side==='left'?xLeft-12:xRight+12"
          },
          "y": {
            "signal": "(datum.start+datum.end)/2*plotHeight"
          },
          "text": {
            "signal": "datum.name==='One person'?['One','person']:datum.name==='Family household'?['Family','household']:datum.name==='Group household'?['Group','household']:datum.name==='Separate house'?['Separate','house']:datum.name==='Other / not stated'?['Other /','not stated']:datum.name"
          },
          "fontSize": {
            "value": 13
          },
          "lineHeight": {
            "value": 15
          },
          "baseline": {
            "value": "middle"
          },
          "align": {
            "signal": "datum.side==='left'?'right':'left'"
          },
          "limit": {
            "signal": "width*.23-12"
          },
          "fill": {
            "value": "#1d1d1d"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans"
  }
}
