{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 520,
  "height": 420,
  "data": {
    "url": "data/cpi.json"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%b %Y",
            "tickCount": 4
          }
        },
        "y": {
          "field": "index",
          "type": "quantitative",
          "title": [
            "Price index",
            "April 2024 = 100"
          ],
          "scale": {
            "domain": [
              0,
              120
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100,
              120
            ]
          }
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Rents",
              "All prices"
            ],
            "range": [
              "#8f4715",
              "#1d1d1d"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "strokeDash": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Rents",
              "All prices"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                6,
                3
              ]
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "series",
            "type": "nominal",
            "title": "Series"
          },
          {
            "field": "index",
            "type": "quantitative",
            "title": "April 2024 = 100",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "date": "2026-07-01",
            "series": "All prices",
            "sourceIndex": 103.07,
            "index": 106.9191,
            "label": "All prices 106.9 (+6.9%)"
          },
          {
            "date": "2026-07-01",
            "series": "Rents",
            "sourceIndex": 103,
            "index": 109.7964,
            "label": "Rents 109.8 (+9.8%)"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 12,
        "fontWeight": 600,
        "dy": {
          "expr": "datum.series==='Rents'?-12:17"
        }
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "index",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Rents",
              "All prices"
            ],
            "range": [
              "#8f4715",
              "#1d1d1d"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  },
  "description": "Both price indexes start at 100 in April 2024, on an axis from zero. By July 2026, rents were 9.8% higher and all prices 6.9% higher. These are eight-capital-city CPI measures, not advertised rents."
}
