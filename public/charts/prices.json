{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 520,
  "height": 320,
  "data": {
    "url": "data/cpi.json"
  },
  "transform": [
    {
      "calculate": "datum.index - 100",
      "as": "change"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "change": 0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#1d1d1d",
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "change",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%b %Y",
            "tickCount": 4
          }
        },
        "y": {
          "field": "change",
          "type": "quantitative",
          "title": [
            "Change since",
            "April 2024"
          ],
          "scale": {
            "domain": [
              -1,
              12
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              4,
              8,
              12
            ],
            "labelExpr": "(datum.value>0?'+':'')+datum.value+'%'"
          }
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Rents",
              "All prices"
            ],
            "range": [
              "#8f4715",
              "#1d1d1d"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "strokeDash": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Rents",
              "All prices"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                6,
                3
              ]
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "series",
            "type": "nominal",
            "title": "Series"
          },
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change since April 2024 (%)",
            "format": "+.1f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  },
  "description": "Both lines begin at 0% in April 2024. +10% means prices are 10% higher than then. These are eight-capital-city CPI measures, not advertised rents."
}
