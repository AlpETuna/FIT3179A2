{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "By July 2026 rents had risen 9.8% since April 2024, against 6.9% for prices across the economy, measured in the eight capital cities.",
  "width": "container",
  "height": 570,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/cpi.json"
  },
  "transform": [
    {
      "calculate": "datum.index - 100",
      "as": "change"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%b %Y",
            "tickCount": 4
          }
        },
        "y": {
          "field": "change",
          "type": "quantitative",
          "title": "Change since April 2024",
          "scale": {
            "domain": [
              0,
              12
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              2,
              4,
              6,
              8,
              10,
              12
            ],
            "labelExpr": "datum.value === 0 ? '0' : '+' + datum.value + '%'"
          }
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Rents",
              "All prices"
            ],
            "range": [
              "#8f4715",
              "#1d1d1d"
            ]
          },
          "legend": null
        },
        "strokeDash": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": [
              "Rents",
              "All prices"
            ],
            "range": [
              [
                1,
                0
              ],
              [
                6,
                3
              ]
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "field": "series",
            "type": "nominal",
            "title": "Series"
          },
          {
            "field": "change",
            "type": "quantitative",
            "title": "Change since April 2024 (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 12,
        "fontWeight": 600,
        "dy": {
          "expr": "datum.series === 'Rents' ? -12 : 0"
        }
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "labelY",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Rents",
              "All prices"
            ],
            "range": [
              "#8f4715",
              "#1d1d1d"
            ]
          },
          "legend": null
        }
      },
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "date",
              "as": "last"
            }
          ]
        },
        {
          "filter": "datum.date === datum.last"
        },
        {
          "calculate": "datum.series + ' +' + format(datum.change, '.1f') + '%'",
          "as": "label"
        },
        {
          "calculate": "datum.series === 'Rents' ? datum.change : datum.change - 2.4",
          "as": "labelY"
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "date": "2024-10-01",
            "change": 9.6
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#1d1d1d",
        "align": "left",
        "lineHeight": 16
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "change",
          "type": "quantitative"
        },
        "text": {
          "value": [
            "Rents rose faster than",
            "prices in general",
            "in every month shown"
          ]
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  }
}
