{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Each cell is the share of recipients in rental stress after assistance, by state and main payment. Students and apprentices on Youth Allowance top every state, at 74–87%.",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/heatmap.json"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": [
            "NSW",
            "Vic",
            "Qld",
            "SA",
            "WA",
            "Tas",
            "NT",
            "ACT"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "payment",
          "type": "nominal",
          "title": null,
          "sort": [
            "Age pension",
            "Disability support",
            "Carer",
            "Single parent",
            "JobSeeker",
            "Student / apprentice"
          ],
          "axis": {
            "labelLimit": 110,
            "labelLineHeight": 15,
            "labelExpr": "datum.label==='Disability support'?['Disability','support']:datum.label==='Student / apprentice'?['Student /','apprentice']:datum.label==='Single parent'?['Single','parent']:datum.label"
          }
        },
        "color": {
          "field": "rate",
          "type": "quantitative",
          "title": "In rental stress after assistance (%)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#f5eff6",
              "#6f3473"
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 220,
            "title": "Recipients in rental stress after assistance (%)",
            "titleLimit": 400
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "fullPayment",
            "type": "nominal",
            "title": "Primary payment"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "In stress after assistance (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "isValid(datum.rate)?format(datum.rate,'.0f')+'%':'—'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14
      },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": [
            "NSW",
            "Vic",
            "Qld",
            "SA",
            "WA",
            "Tas",
            "NT",
            "ACT"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "payment",
          "type": "nominal",
          "title": null,
          "sort": [
            "Age pension",
            "Disability support",
            "Carer",
            "Single parent",
            "JobSeeker",
            "Student / apprentice"
          ],
          "axis": {
            "labelLimit": 110,
            "labelLineHeight": 15,
            "labelExpr": "datum.label==='Disability support'?['Disability','support']:datum.label==='Student / apprentice'?['Student /','apprentice']:datum.label==='Single parent'?['Single','parent']:datum.label"
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.rate>72",
            "value": "#fff"
          },
          "value": "#000000"
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  }
}
