{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 1000,
  "height": 310,
  "data": {
    "url": "data/heatmap.json"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "payment",
          "type": "nominal",
          "title": null,
          "sort": [
            "Age pension",
            "Disability support",
            "Carer",
            "Single parent",
            "JobSeeker",
            "Student / apprentice"
          ],
          "axis": {
            "orient": "top",
            "labelAngle": 0,
            "labelLimit": 175
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": [
            "NSW",
            "Vic",
            "Qld",
            "SA",
            "WA",
            "Tas",
            "NT",
            "ACT"
          ]
        },
        "color": {
          "field": "rate",
          "type": "quantitative",
          "title": "In rental stress after assistance (%)",
          "scale": {
            "domain": [
              0,
              100
            ],
            "range": [
              "#f5eff6",
              "#6f3473"
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 240
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "fullPayment",
            "type": "nominal",
            "title": "Primary payment"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "In stress after assistance (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "isValid(datum.rate)?format(datum.rate,'.0f')+'%':'—'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 14
      },
      "encoding": {
        "x": {
          "field": "payment",
          "type": "nominal",
          "title": null,
          "sort": [
            "Age pension",
            "Disability support",
            "Carer",
            "Single parent",
            "JobSeeker",
            "Student / apprentice"
          ]
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": [
            "NSW",
            "Vic",
            "Qld",
            "SA",
            "WA",
            "Tas",
            "NT",
            "ACT"
          ]
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.rate>72",
            "value": "#fff"
          },
          "value": "#000000"
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  },
  "description": "Each cell shows the percentage in rental stress after assistance within that state and primary payment group. The six selected groups are distinct published categories, not the entire recipient population. Student / apprentice means Youth Allowance; single parent means Parenting Payment (Single)."
}
