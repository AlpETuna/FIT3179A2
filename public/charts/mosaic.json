{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Each column is a dwelling type, as wide as its share of homes; colours show how those homes are held. 63% of apartments are rented, against 21% of houses. Other and unstated dwelling types (1% of homes) are left out.",
  "width": "container",
  "height": 300,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/mosaic.json"
  },
  "transform": [
    {
      "calculate": "datum.dwelling === 'Other dwelling' || datum.dwelling === 'Not stated' ? 'Other / not stated' : datum.dwelling",
      "as": "dwelling"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "count"
        }
      ],
      "groupby": [
        "dwelling",
        "tenure"
      ]
    },
    {
      "filter": "datum.dwelling !== 'Other / not stated'"
    },
    {
      "calculate": "indexof([\"Separate house\", \"Townhouse\", \"Apartment\", \"Other / not stated\"], datum.dwelling)",
      "as": "dOrder"
    },
    {
      "calculate": "indexof([\"Owned outright\", \"Mortgage\", \"Renting\", \"Other tenure\", \"Not stated\"], datum.tenure)",
      "as": "tOrder"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "dwellingTotal"
        }
      ],
      "groupby": [
        "dwelling"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "total"
        }
      ]
    },
    {
      "calculate": "datum.count / datum.dwellingTotal",
      "as": "within"
    },
    {
      "stack": "count",
      "groupby": [
        "dwelling"
      ],
      "sort": [
        {
          "field": "tOrder"
        }
      ],
      "offset": "normalize",
      "as": [
        "y",
        "y2"
      ]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "count",
          "as": "running"
        }
      ],
      "sort": [
        {
          "field": "dOrder"
        },
        {
          "field": "tOrder"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "running",
          "as": "columnEnd"
        }
      ],
      "groupby": [
        "dwelling"
      ]
    },
    {
      "calculate": "datum.columnEnd / datum.total",
      "as": "x2"
    },
    {
      "calculate": "(datum.columnEnd - datum.dwellingTotal) / datum.total",
      "as": "x"
    }
  ],
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "title": null,
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          }
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "title": "Share within dwelling type",
          "axis": {
            "format": ".0%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ]
          },
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          }
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "tenure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Owned outright",
              "Mortgage",
              "Renting",
              "Other tenure",
              "Not stated"
            ],
            "range": [
              "#158374",
              "#2b6399",
              "#8f4715",
              "#9e9e9e",
              "#dedede"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "dwelling",
            "type": "nominal",
            "title": "Dwelling"
          },
          {
            "field": "tenure",
            "type": "nominal",
            "title": "Tenure"
          },
          {
            "field": "within",
            "type": "quantitative",
            "title": "Share within dwelling type",
            "format": ".1%"
          },
          {
            "field": "count",
            "type": "quantitative",
            "title": "Homes",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#585858",
        "baseline": "top",
        "y": "height",
        "dy": 6,
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      },
      "transform": [
        {
          "filter": "datum.tOrder === 0 && datum.x2 - datum.x > 0.1"
        },
        {
          "calculate": "(datum.x + datum.x2) / 2",
          "as": "mid"
        },
        {
          "calculate": "datum.dwelling === 'Townhouse' ? ['Town-', 'house'] : datum.dwelling === 'Apartment' ? ['Apart-', 'ment'] : datum.dwelling",
          "as": "label"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.dwelling === 'Apartment' && datum.tenure === 'Renting'"
        },
        {
          "calculate": "(datum.x + datum.x2) / 2",
          "as": "mid"
        },
        {
          "calculate": "(datum.y + datum.y2) / 2",
          "as": "midY"
        },
        {
          "calculate": "[format(datum.within, '.0%'), 'rented']",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#ffffff",
        "lineHeight": 15
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "y": {
          "field": "midY",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.dwelling === 'Separate house' && datum.tenure === 'Renting'"
        },
        {
          "calculate": "(datum.x + datum.x2) / 2",
          "as": "mid"
        },
        {
          "calculate": "(datum.y + datum.y2) / 2",
          "as": "midY"
        },
        {
          "calculate": "format(datum.within, '.0%') + ' of houses rented'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#ffffff"
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "y": {
          "field": "midY",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
