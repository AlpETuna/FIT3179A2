{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Each dot is a region; dashed lines mark the Australian medians. Melbourne City renters pay above-median rent on below-median incomes.",
  "width": "container",
  "height": 455,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "params": [
    {
      "name": "featured",
      "value": "all"
    }
  ],
  "data": {
    "url": "data/sa3.json"
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 32,
        "color": "#8a8a8a",
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "income",
          "type": "quantitative",
          "title": "Median household income / week ($)",
          "scale": {
            "zero": false
          },
          "axis": {
            "format": "$,.0f",
            "values": [
              800,
              1200,
              1600,
              2000,
              2400,
              2800,
              3200
            ]
          }
        },
        "y": {
          "field": "rent",
          "type": "quantitative",
          "title": "Median rent / week ($)",
          "scale": {
            "zero": false
          },
          "axis": {
            "format": "$,.0f",
            "values": [
              100,
              200,
              300,
              400,
              500,
              600,
              700
            ]
          }
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "rent",
            "type": "quantitative",
            "title": "Median rent / week",
            "format": "$,.0f"
          },
          {
            "field": "income",
            "type": "quantitative",
            "title": "Median household income / week",
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "regression": "rent",
          "on": "income"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#585858",
        "strokeWidth": 1.5,
        "opacity": 0.7,
        "strokeDash": [
          1,
          0
        ]
      },
      "encoding": {
        "x": {
          "field": "income",
          "type": "quantitative"
        },
        "y": {
          "field": "rent",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "income": 1746
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [
              4,
              4
            ],
            "color": "#777"
          },
          "encoding": {
            "x": {
              "field": "income",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#585858",
            "align": "right",
            "angle": 270,
            "baseline": "bottom",
            "dx": 4,
            "dy": -4,
            "y": 0
          },
          "encoding": {
            "x": {
              "field": "income",
              "type": "quantitative"
            },
            "text": {
              "value": "Australia $1,746"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "rent": 375
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [
              4,
              4
            ],
            "color": "#777"
          },
          "encoding": {
            "y": {
              "field": "rent",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#585858",
            "align": "right",
            "x": "width",
            "baseline": "bottom",
            "dy": -4
          },
          "encoding": {
            "y": {
              "field": "rent",
              "type": "quantitative"
            },
            "text": {
              "value": "Australia $375"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "income": 3272,
            "rent": 720,
            "label": [
              "Manly: highest rent",
              "$720 a week"
            ],
            "align": "right"
          },
          {
            "income": 3114,
            "rent": 220,
            "label": [
              "West Pilbara: mining wages,",
              "company housing, low rent"
            ],
            "align": "right"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "color": "#1d1d1d",
        "align": "right",
        "baseline": "middle",
        "dx": -9,
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "field": "income",
          "type": "quantitative"
        },
        "y": {
          "field": "rent",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "code",
            "oneOf": [
              "20604",
              "21203",
              "20201"
            ]
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "color": "#8f4715",
        "stroke": "#1d1d1d",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "income",
          "type": "quantitative"
        },
        "y": {
          "field": "rent",
          "type": "quantitative"
        },
        "opacity": {
          "condition": {
            "test": "featured === 'all' || datum.code === featured",
            "value": 1
          },
          "value": 0.18
        },
        "tooltip": [
          {
            "field": "name",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "rent",
            "type": "quantitative",
            "title": "Median rent / week",
            "format": "$,.0f"
          },
          {
            "field": "income",
            "type": "quantitative",
            "title": "Median household income / week",
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "code",
            "oneOf": [
              "20604",
              "21203",
              "20201"
            ]
          }
        },
        {
          "calculate": "replace(datum.name,' - ',' – ')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "stroke": "#ffffff",
        "strokeWidth": 4,
        "strokeJoin": "round",
        "align": {
          "expr": "datum.code==='21203'?'left':'right'"
        },
        "dx": {
          "expr": "datum.code==='21203'?10:-10"
        },
        "dy": {
          "expr": "datum.code==='20604'?-14:datum.code==='21203'?16:0"
        }
      },
      "encoding": {
        "x": {
          "field": "income",
          "type": "quantitative"
        },
        "y": {
          "field": "rent",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "test": "featured === 'all' || datum.code === featured",
            "value": 1
          },
          "value": 0.18
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "code",
            "oneOf": [
              "20604",
              "21203",
              "20201"
            ]
          }
        },
        {
          "calculate": "replace(datum.name,' - ',' – ')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": 600,
        "color": "#1d1d1d",
        "align": {
          "expr": "datum.code==='21203'?'left':'right'"
        },
        "dx": {
          "expr": "datum.code==='21203'?10:-10"
        },
        "dy": {
          "expr": "datum.code==='20604'?-14:datum.code==='21203'?16:0"
        }
      },
      "encoding": {
        "x": {
          "field": "income",
          "type": "quantitative"
        },
        "y": {
          "field": "rent",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "opacity": {
          "condition": {
            "test": "featured === 'all' || datum.code === featured",
            "value": 1
          },
          "value": 0.18
        }
      }
    }
  ],
  "config": {
    "font": "Libre Franklin",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Libre Franklin",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  }
}
