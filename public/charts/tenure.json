{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Each square is about 1% of Australia’s 9.3 million occupied homes in 2021. Renters (31%) now almost match people who own outright (31%).",
  "width": 320,
  "height": 320,
  "data": {
    "url": "data/tenure.json"
  },
  "transform": [
    {
      "calculate": "indexof([\"Owned outright\", \"Mortgage\", \"Renting\", \"Other tenure\", \"Not stated\"], datum.tenure)",
      "as": "order"
    },
    {
      "calculate": "floor(datum.share * 100)",
      "as": "whole"
    },
    {
      "calculate": "datum.share * 100 - datum.whole",
      "as": "remainder"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "whole",
          "as": "allocated"
        }
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "remainder",
          "order": "descending"
        }
      ]
    },
    {
      "calculate": "datum.whole + (datum.rank <= 100 - datum.allocated ? 1 : 0)",
      "as": "tiles"
    },
    {
      "calculate": "sequence(datum.tiles)",
      "as": "tile"
    },
    {
      "flatten": [
        "tile"
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "index"
        }
      ],
      "sort": [
        {
          "field": "order"
        },
        {
          "field": "tile"
        }
      ]
    },
    {
      "calculate": "(datum.index - 1) % 10",
      "as": "col"
    },
    {
      "calculate": "floor((datum.index - 1) / 10)",
      "as": "row"
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#fff",
    "strokeWidth": 3
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "tenure",
      "type": "nominal",
      "scale": {
        "domain": [
          "Owned outright",
          "Mortgage",
          "Renting",
          "Other tenure",
          "Not stated"
        ],
        "range": [
          "#158374",
          "#2b6399",
          "#8f4715",
          "#9e9e9e",
          "#dedede"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "tenure",
        "type": "nominal",
        "title": "Tenure"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share of occupied homes",
        "format": ".1%"
      },
      {
        "field": "count",
        "type": "quantitative",
        "title": "Homes",
        "format": ","
      }
    ]
  },
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  }
}
