{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Each line is a region, read across four measures. Melbourne City and Casey – South charge almost the same rent, but 86% of Melbourne City’s homes are apartments, against 1% in Casey – South.",
  "padding": {
    "left": 50,
    "right": 25,
    "top": 45,
    "bottom": 12
  },
  "autosize": "none",
  "signals": [
    {
      "name": "width",
      "init": "max(200, containerSize()[0] - 75)"
    },
    {
      "name": "height",
      "update": "width < 500 ? 300 : 330"
    },
    {
      "name": "featured",
      "value": "all"
    }
  ],
  "data": [
    {
      "name": "axes",
      "values": [
        {
          "field": "income",
          "label": "Income / week",
          "i": 0,
          "max": 4000,
          "min": 0,
          "short": [
            "Income",
            "/ week"
          ]
        },
        {
          "field": "rent",
          "label": "Rent / week",
          "i": 1,
          "max": 800,
          "min": 0,
          "short": [
            "Rent",
            "/ week"
          ]
        },
        {
          "field": "mortgageWeekly",
          "label": "Mortgage / week",
          "i": 2,
          "max": 1000,
          "min": 0,
          "short": [
            "Mortgage",
            "/ week"
          ]
        },
        {
          "field": "apartmentShare",
          "label": "Apartments",
          "i": 3,
          "max": 1,
          "min": 0,
          "short": [
            "Apartments"
          ]
        }
      ]
    },
    {
      "name": "ticks",
      "values": [
        {
          "field": "income",
          "normal": 0,
          "text": "$0"
        },
        {
          "field": "income",
          "normal": 0.25,
          "text": "$1,000"
        },
        {
          "field": "income",
          "normal": 0.5,
          "text": "$2,000"
        },
        {
          "field": "income",
          "normal": 0.75,
          "text": "$3,000"
        },
        {
          "field": "income",
          "normal": 1,
          "text": "$4,000"
        },
        {
          "field": "rent",
          "normal": 0,
          "text": "$0"
        },
        {
          "field": "rent",
          "normal": 0.25,
          "text": "$200"
        },
        {
          "field": "rent",
          "normal": 0.5,
          "text": "$400"
        },
        {
          "field": "rent",
          "normal": 0.75,
          "text": "$600"
        },
        {
          "field": "rent",
          "normal": 1,
          "text": "$800"
        },
        {
          "field": "mortgageWeekly",
          "normal": 0,
          "text": "$0"
        },
        {
          "field": "mortgageWeekly",
          "normal": 0.25,
          "text": "$250"
        },
        {
          "field": "mortgageWeekly",
          "normal": 0.5,
          "text": "$500"
        },
        {
          "field": "mortgageWeekly",
          "normal": 0.75,
          "text": "$750"
        },
        {
          "field": "mortgageWeekly",
          "normal": 1,
          "text": "$1,000"
        },
        {
          "field": "apartmentShare",
          "normal": 0,
          "text": "0%"
        },
        {
          "field": "apartmentShare",
          "normal": 0.25,
          "text": "25%"
        },
        {
          "field": "apartmentShare",
          "normal": 0.5,
          "text": "50%"
        },
        {
          "field": "apartmentShare",
          "normal": 0.75,
          "text": "75%"
        },
        {
          "field": "apartmentShare",
          "normal": 1,
          "text": "100%"
        }
      ]
    },
    {
      "name": "profiles",
      "url": "data/sa3.json",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.income) && isValid(datum.rent) && isValid(datum.mortgageWeekly) && isValid(datum.apartmentShare)"
        },
        {
          "type": "fold",
          "fields": [
            "income",
            "rent",
            "mortgageWeekly",
            "apartmentShare"
          ],
          "as": [
            "dimension",
            "raw"
          ]
        },
        {
          "type": "lookup",
          "from": "axes",
          "key": "field",
          "fields": [
            "dimension"
          ],
          "values": [
            "max",
            "label"
          ],
          "as": [
            "max",
            "label"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.raw / datum.max",
          "as": "normal"
        },
        {
          "type": "formula",
          "expr": "indexof(['20604', '21203', '20201'], datum.code) >= 0",
          "as": "featured"
        }
      ]
    },
    {
      "name": "context",
      "source": "profiles",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.featured"
        }
      ]
    },
    {
      "name": "examples",
      "source": "profiles",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.featured"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "point",
      "domain": [
        "income",
        "rent",
        "mortgageWeekly",
        "apartmentShare"
      ],
      "range": "width",
      "padding": 0.16
    },
    {
      "name": "y",
      "type": "linear",
      "domain": [
        0,
        1
      ],
      "range": "height"
    }
  ],
  "marks": [
    {
      "type": "rule",
      "from": {
        "data": "axes"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "field"
          },
          "y": {
            "value": 0
          },
          "y2": {
            "signal": "height"
          },
          "stroke": {
            "value": "#c3c3c3"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "axes"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "field"
          },
          "y": {
            "signal": "width < 500 ? -30 : -16"
          },
          "align": {
            "value": "center"
          },
          "text": {
            "signal": "width < 500 ? datum.short : datum.label"
          },
          "fill": {
            "value": "#1d1d1d"
          },
          "fontSize": {
            "signal": "width < 500 ? 12 : 13"
          },
          "fontWeight": {
            "value": 600
          }
        }
      }
    },
    {
      "type": "rule",
      "from": {
        "data": "ticks"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "field",
            "offset": -4
          },
          "x2": {
            "scale": "x",
            "field": "field"
          },
          "y": {
            "scale": "y",
            "field": "normal"
          },
          "stroke": {
            "value": "#9a9a9a"
          }
        }
      }
    },
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "line",
          "data": "context",
          "groupby": "code"
        }
      },
      "marks": [
        {
          "type": "line",
          "from": {
            "data": "line"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "x",
                "field": "dimension"
              },
              "y": {
                "scale": "y",
                "field": "normal"
              },
              "stroke": {
                "value": "#777"
              },
              "strokeOpacity": {
                "value": 0.11
              },
              "strokeWidth": {
                "value": 1
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "from": {
        "facet": {
          "name": "highlight",
          "data": "examples",
          "groupby": "code"
        }
      },
      "marks": [
        {
          "type": "line",
          "from": {
            "data": "highlight"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "x",
                "field": "dimension"
              },
              "y": {
                "scale": "y",
                "field": "normal"
              },
              "stroke": {
                "value": "#8f4715"
              },
              "strokeWidth": {
                "value": 2.2
              },
              "strokeDash": {
                "signal": "datum.code==='20604'?[1,0]:datum.code==='21203'?[7,3]:[2,3]"
              },
              "strokeOpacity": {
                "signal": "featured==='all'||datum.code===featured?1:.12"
              },
              "tooltip": {
                "signal": "{'Region':datum.name}"
              }
            }
          }
        },
        {
          "type": "symbol",
          "from": {
            "data": "highlight"
          },
          "encode": {
            "update": {
              "x": {
                "scale": "x",
                "field": "dimension"
              },
              "y": {
                "scale": "y",
                "field": "normal"
              },
              "size": {
                "value": 40
              },
              "fill": {
                "value": "#8f4715"
              },
              "opacity": {
                "signal": "featured==='all'||datum.code===featured?1:.12"
              },
              "tooltip": {
                "signal": "{'Region':datum.name,'Measure':datum.label,'Value':datum.dimension==='apartmentShare'?format(datum.raw,'.1%'):format(datum.raw,'$,.0f')}"
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "from": {
        "data": "ticks"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "field",
            "offset": -7
          },
          "y": {
            "scale": "y",
            "field": "normal"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "width < 500 ? replace(datum.text, ',000', 'k') : datum.text"
          },
          "fill": {
            "value": "#585858"
          },
          "fontSize": {
            "signal": "width < 500 ? 11 : 12"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 3
          },
          "strokeJoin": {
            "value": "round"
          }
        }
      },
      "interactive": false
    },
    {
      "type": "text",
      "from": {
        "data": "ticks"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "x",
            "field": "field",
            "offset": -7
          },
          "y": {
            "scale": "y",
            "field": "normal"
          },
          "align": {
            "value": "right"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "width < 500 ? replace(datum.text, ',000', 'k') : datum.text"
          },
          "fill": {
            "value": "#585858"
          },
          "fontSize": {
            "signal": "width < 500 ? 11 : 12"
          }
        }
      },
      "interactive": false
    }
  ],
  "config": {
    "text": {
      "font": "Public Sans"
    },
    "axis": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans"
    },
    "legend": {
      "labelFont": "Public Sans",
      "titleFont": "Public Sans"
    },
    "title": {
      "font": "Public Sans"
    }
  }
}
