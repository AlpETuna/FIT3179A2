{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Each bar counts the regions whose median weekly rent falls in a $50 band. 194 of 335 regions sit between $300 and $449 a week.",
  "width": "container",
  "height": 420,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/sa3.json"
  },
  "config": {
    "font": "Libre Franklin",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Libre Franklin",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "binSpacing": 1
      },
      "encoding": {
        "x": {
          "field": "rent",
          "type": "quantitative",
          "title": "Regional median weekly rent ($)",
          "bin": {
            "step": 50
          },
          "axis": {
            "format": "$,.0f"
          }
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "title": "Number of regions"
        },
        "tooltip": [
          {
            "field": "rent",
            "type": "quantitative",
            "title": "Rent band starts at",
            "bin": {
              "step": 50
            },
            "format": "$,.0f"
          },
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Regions"
          }
        ],
        "color": {
          "condition": {
            "test": "datum.bin_step_50_rent >= 300 && datum.bin_step_50_rent < 450",
            "value": "#8f4715"
          },
          "value": "#d9b48c"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "rent": 600,
            "count": 14,
            "label": [
              "Sydney’s dearest",
              "regions: $600+"
            ]
          },
          {
            "rent": 60,
            "count": 17,
            "label": [
              "Remote NT",
              "from $80"
            ]
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "color": "#1d1d1d",
        "align": "left",
        "lineHeight": 14,
        "baseline": "bottom"
      },
      "encoding": {
        "x": {
          "field": "rent",
          "type": "quantitative"
        },
        "y": {
          "field": "count",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
