{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 520,
  "height": 290,
  "data": {
    "url": "data/sa3.json"
  },
  "mark": {
    "type": "bar",
    "color": "#8f4715",
    "binSpacing": 1
  },
  "encoding": {
    "x": {
      "field": "rent",
      "type": "quantitative",
      "title": "Regional median weekly rent ($)",
      "bin": {
        "step": 50
      },
      "axis": {
        "format": "$,.0f"
      }
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of regions"
    },
    "tooltip": [
      {
        "field": "rent",
        "type": "quantitative",
        "title": "Rent band starts at",
        "bin": {
          "step": 50
        },
        "format": "$,.0f"
      },
      {
        "aggregate": "count",
        "type": "quantitative",
        "title": "Regions"
      }
    ]
  },
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  },
  "description": "Each bar counts regions whose median weekly rent falls within a $50 interval. This is a distribution of regional medians, not a distribution of renters or their rent payments."
}
