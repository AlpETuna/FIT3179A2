{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Each row is one state: the line runs from its cheapest region to its dearest, the box holds the middle half of its regions and the white mark is the typical region. NSW alone stretches from $150 to $720 a week.",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/sa3.json"
  },
  "config": {
    "font": "Libre Franklin",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Libre Franklin",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 22,
        "color": "#8f4715",
        "median": {
          "color": "#fff",
          "strokeWidth": 2
        },
        "outliers": false
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": [
            "ACT",
            "NSW",
            "Qld",
            "Vic",
            "WA",
            "SA",
            "Tas",
            "NT"
          ]
        },
        "x": {
          "field": "rent",
          "type": "quantitative",
          "title": "Regional median weekly rent ($)",
          "axis": {
            "format": "$,.0f"
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "rent": 720,
            "label": "Manly $720",
            "side": "right"
          },
          {
            "state": "NT",
            "rent": 80,
            "label": "Arnhem Land $80",
            "side": "below"
          },
          {
            "state": "ACT",
            "rent": 290,
            "label": "Narrowest spread",
            "side": "left"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "color": "#1d1d1d",
        "align": {
          "expr": "datum.side==='right'?'right':datum.side==='left'?'right':'left'"
        },
        "dx": {
          "expr": "datum.side==='right'?0:datum.side==='left'?-6:2"
        },
        "dy": {
          "expr": "datum.side==='right'||datum.side==='below'?-15:datum.side==='left'?-12:0"
        }
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "ACT",
            "NSW",
            "Qld",
            "Vic",
            "WA",
            "SA",
            "Tas",
            "NT"
          ]
        },
        "x": {
          "field": "rent",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
