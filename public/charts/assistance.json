{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Each pair is the same recipients in March 2026: grey leaves rent assistance out, purple counts it. Rental stress means paying more than 30% of income in rent.",
  "width": "container",
  "height": 320,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "data": {
    "url": "data/cra.json"
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "rate": 75.1,
            "label": "Australia 75%"
          },
          {
            "rate": 44.0,
            "label": "Australia 44%"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeDash": [
              3,
              3
            ],
            "color": "#9a9a9a"
          },
          "encoding": {
            "x": {
              "field": "rate",
              "type": "quantitative"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11,
            "color": "#585858",
            "y": 0,
            "dy": -8,
            "dx": 4,
            "align": "left",
            "baseline": "bottom"
          },
          "encoding": {
            "x": {
              "field": "rate",
              "type": "quantitative"
            },
            "text": {
              "field": "label"
            }
          }
        }
      ]
    },
    {
      "mark": {
        "type": "rule",
        "stroke": "#aaa",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": [
            "NSW",
            "Vic",
            "Qld",
            "SA",
            "WA",
            "Tas",
            "NT",
            "ACT"
          ]
        },
        "x": {
          "field": "after",
          "type": "quantitative",
          "title": "Share of rent-assistance recipients paying over 30% of income in rent",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'"
          }
        },
        "x2": {
          "field": "before"
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "before",
            "type": "quantitative",
            "title": "Without assistance (%)",
            "format": ".1f"
          },
          {
            "field": "after",
            "type": "quantitative",
            "title": "With assistance (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "before",
            "after"
          ],
          "as": [
            "basis",
            "rate"
          ]
        },
        {
          "calculate": "datum.basis==='before'?'Without assistance':'With assistance'",
          "as": "basisLabel"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100,
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "sort": [
            "NSW",
            "Vic",
            "Qld",
            "SA",
            "WA",
            "Tas",
            "NT",
            "ACT"
          ]
        },
        "x": {
          "field": "rate",
          "type": "quantitative"
        },
        "color": {
          "field": "basisLabel",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Without assistance",
              "With assistance"
            ],
            "range": [
              "#8a8a8a",
              "#6f3473"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "shape": {
          "field": "basisLabel",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Without assistance",
              "With assistance"
            ],
            "range": [
              "circle",
              "diamond"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "basisLabel",
            "type": "nominal",
            "title": "Calculation"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "In rental stress (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "ACT",
            "after": 51.5,
            "label": "ACT: still one in two"
          },
          {
            "state": "Tas",
            "after": 32.9,
            "label": "Tas: one in three"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11.5,
        "color": "#1d1d1d",
        "align": "right",
        "dx": -12
      },
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": [
            "NSW",
            "Vic",
            "Qld",
            "SA",
            "WA",
            "Tas",
            "NT",
            "ACT"
          ]
        },
        "x": {
          "field": "after",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  }
}
