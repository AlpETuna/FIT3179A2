{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 520,
  "height": 320,
  "projection": {
    "type": "albers",
    "rotate": [
      -132,
      0,
      0
    ],
    "center": [
      0,
      -28
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/states.topo.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "transform": [
        {
          "calculate": "['NSW','Vic','Qld','SA','WA','Tas','NT','ACT'][toNumber(datum.properties.STE_CODE21)-1]",
          "as": "state"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/cra.json"
            },
            "key": "state",
            "fields": [
              "severe"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },
      "encoding": {
        "color": {
          "field": "severe",
          "type": "quantitative",
          "title": "Share after assistance (%)",
          "scale": {
            "domain": [
              0,
              30
            ],
            "range": [
              "#f5eff6",
              "#6f3473"
            ],
            "clamp": true
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "format": ".0f",
            "gradientLength": 180,
            "title": [
              "Share after",
              "assistance (%)"
            ]
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "severe",
            "type": "quantitative",
            "title": "Over 50% after assistance (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "lon": 146.8,
            "lat": -31.9,
            "outside": false
          },
          {
            "state": "Vic",
            "lon": 139.2,
            "lat": -43.4,
            "ax": 143.6,
            "ay": -37.4,
            "outside": true
          },
          {
            "state": "Qld",
            "lon": 144.6,
            "lat": -22.6,
            "outside": false
          },
          {
            "state": "SA",
            "lon": 135.2,
            "lat": -30.2,
            "outside": false
          },
          {
            "state": "WA",
            "lon": 122.2,
            "lat": -26,
            "outside": false
          },
          {
            "state": "Tas",
            "lon": 151.5,
            "lat": -42.6,
            "ax": 146.7,
            "ay": -42,
            "outside": true
          },
          {
            "state": "NT",
            "lon": 133.4,
            "lat": -19.6,
            "outside": false
          },
          {
            "state": "ACT",
            "lon": 154,
            "lat": -36.6,
            "ax": 149.1,
            "ay": -35.45,
            "outside": true
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.outside"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#1d1d1d",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "ax"
        },
        "latitude2": {
          "field": "ay"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "lon": 146.8,
            "lat": -31.9,
            "outside": false
          },
          {
            "state": "Vic",
            "lon": 139.2,
            "lat": -43.4,
            "ax": 143.6,
            "ay": -37.4,
            "outside": true
          },
          {
            "state": "Qld",
            "lon": 144.6,
            "lat": -22.6,
            "outside": false
          },
          {
            "state": "SA",
            "lon": 135.2,
            "lat": -30.2,
            "outside": false
          },
          {
            "state": "WA",
            "lon": 122.2,
            "lat": -26,
            "outside": false
          },
          {
            "state": "Tas",
            "lon": 151.5,
            "lat": -42.6,
            "ax": 146.7,
            "ay": -42,
            "outside": true
          },
          {
            "state": "NT",
            "lon": 133.4,
            "lat": -19.6,
            "outside": false
          },
          {
            "state": "ACT",
            "lon": 154,
            "lat": -36.6,
            "ax": 149.1,
            "ay": -35.45,
            "outside": true
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/cra.json"
            },
            "key": "state",
            "fields": [
              "severe"
            ]
          }
        }
      ],
      "mark": {
        "type": "text",
        "dy": -9,
        "fontWeight": 600,
        "fontSize": 13,
        "align": {
          "expr": "datum.outside?'left':'center'"
        },
        "dx": {
          "expr": "datum.outside?6:0"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.severe>21.6 && !datum.outside",
            "value": "#ffffff"
          },
          "value": "#000000"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
            "lon": 146.8,
            "lat": -31.9,
            "outside": false
          },
          {
            "state": "Vic",
            "lon": 139.2,
            "lat": -43.4,
            "ax": 143.6,
            "ay": -37.4,
            "outside": true
          },
          {
            "state": "Qld",
            "lon": 144.6,
            "lat": -22.6,
            "outside": false
          },
          {
            "state": "SA",
            "lon": 135.2,
            "lat": -30.2,
            "outside": false
          },
          {
            "state": "WA",
            "lon": 122.2,
            "lat": -26,
            "outside": false
          },
          {
            "state": "Tas",
            "lon": 151.5,
            "lat": -42.6,
            "ax": 146.7,
            "ay": -42,
            "outside": true
          },
          {
            "state": "NT",
            "lon": 133.4,
            "lat": -19.6,
            "outside": false
          },
          {
            "state": "ACT",
            "lon": 154,
            "lat": -36.6,
            "ax": 149.1,
            "ay": -35.45,
            "outside": true
          }
        ]
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/cra.json"
            },
            "key": "state",
            "fields": [
              "severe"
            ]
          }
        },
        {
          "calculate": "format(datum.severe,'.1f')+'%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 8,
        "fontSize": 14,
        "align": {
          "expr": "datum.outside?'left':'center'"
        },
        "dx": {
          "expr": "datum.outside?6:0"
        }
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.severe>21.6 && !datum.outside",
            "value": "#ffffff"
          },
          "value": "#000000"
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "domain": false,
      "tickColor": "#c8c8c8",
      "gridColor": "#e9e9e9",
      "labelPadding": 7,
      "titlePadding": 13
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 400,
      "labelColor": "#585858",
      "titleColor": "#585858",
      "padding": 8
    },
    "title": {
      "font": "Public Sans",
      "fontSize": 14,
      "fontWeight": 600,
      "color": "#1d1d1d",
      "anchor": "start"
    }
  },
  "description": "Darker states have a larger share of assistance recipients paying over half their income in rent, after assistance. Small states are labelled offshore."
}
