{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Circle area shows how many rent-assistance recipients pay more than half their income in rent after assistance; colour shows their share of the state’s recipients. Most live in the big eastern states, but the ACT has the highest share.",
  "padding": {
    "left": 2,
    "right": 2,
    "top": 4,
    "bottom": 4
  },
  "autosize": "none",
  "signals": [
    {
      "name": "width",
      "init": "max(200, containerSize()[0] - 4)"
    },
    {
      "name": "mapHeight",
      "update": "min(420, round(width * 0.8))"
    },
    {
      "name": "height",
      "update": "mapHeight + 118"
    },
    {
      "name": "baseScale",
      "update": "min(width / 0.75, mapHeight / 0.62) * 0.95"
    },
    {
      "name": "maxRadius",
      "update": "min(width, mapHeight * 1.25) * 0.08",
      "description": "Radius of a circle for 100,000 people."
    }
  ],
  "projections": [
    {
      "name": "proj",
      "type": "albers",
      "rotate": [
        -132,
        0,
        0
      ],
      "center": [
        0,
        -28
      ],
      "parallels": [
        -18,
        -36
      ],
      "scale": {
        "signal": "baseScale"
      },
      "translate": [
        {
          "signal": "width / 2"
        },
        {
          "signal": "mapHeight / 2"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "cra",
      "url": "data/cra.json"
    },
    {
      "name": "states",
      "url": "data/states.topo.json",
      "format": {
        "type": "topojson",
        "feature": "states"
      },
      "transform": [
        {
          "type": "formula",
          "expr": "['NSW','Vic','Qld','SA','WA','Tas','NT','ACT'][toNumber(datum.properties.STE_CODE21)-1]",
          "as": "state"
        }
      ]
    },
    {
      "name": "symbols",
      "description": "Where each state’s circle sits. The ACT circle is moved out to sea, with a leader line to Canberra.",
      "values": [
        {
          "state": "NSW",
          "lon": 146,
          "lat": -30.6,
          "ax": null,
          "ay": null
        },
        {
          "state": "Vic",
          "lon": 144,
          "lat": -38,
          "ax": null,
          "ay": null
        },
        {
          "state": "Qld",
          "lon": 144.5,
          "lat": -22,
          "ax": null,
          "ay": null
        },
        {
          "state": "SA",
          "lon": 135,
          "lat": -30.5,
          "ax": null,
          "ay": null
        },
        {
          "state": "WA",
          "lon": 121.8,
          "lat": -27,
          "ax": null,
          "ay": null
        },
        {
          "state": "Tas",
          "lon": 146.6,
          "lat": -41.9,
          "ax": null,
          "ay": null
        },
        {
          "state": "NT",
          "lon": 133.4,
          "lat": -20.5,
          "ax": null,
          "ay": null
        },
        {
          "state": "ACT",
          "lon": 152.8,
          "lat": -37.2,
          "ax": 149.1,
          "ay": -35.45
        }
      ],
      "transform": [
        {
          "type": "lookup",
          "from": "cra",
          "key": "state",
          "fields": [
            "state"
          ],
          "as": [
            "row"
          ]
        },
        {
          "type": "formula",
          "expr": "sqrt(datum.row.severeCount / 100000) * maxRadius",
          "as": "r"
        },
        {
          "type": "geopoint",
          "projection": "proj",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "x",
            "y"
          ]
        },
        {
          "type": "geopoint",
          "projection": "proj",
          "fields": [
            "ax",
            "ay"
          ],
          "as": [
            "axp",
            "ayp"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.r >= 18",
          "as": "inside"
        }
      ]
    },
    {
      "name": "sizeKey",
      "values": [
        {
          "v": 10000,
          "label": "10,000"
        },
        {
          "v": 50000,
          "label": "50,000"
        },
        {
          "v": 100000,
          "label": "100,000 people"
        }
      ],
      "transform": [
        {
          "type": "formula",
          "expr": "sqrt(datum.v / 100000) * maxRadius",
          "as": "r"
        }
      ]
    },
    {
      "name": "colourKey",
      "values": [
        {
          "i": 0,
          "label": "Under 15%"
        },
        {
          "i": 1,
          "label": "15–20%"
        },
        {
          "i": 2,
          "label": "20–25%"
        },
        {
          "i": 3,
          "label": "25% or more"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "colour",
      "type": "threshold",
      "domain": [
        15,
        20,
        25
      ],
      "range": [
        "#e3d3e5",
        "#a06aa5",
        "#7a4180",
        "#4f1f55"
      ]
    },
    {
      "name": "swatch",
      "type": "ordinal",
      "domain": [
        0,
        1,
        2,
        3
      ],
      "range": [
        "#e3d3e5",
        "#a06aa5",
        "#7a4180",
        "#4f1f55"
      ]
    }
  ],
  "marks": [
    {
      "type": "group",
      "encode": {
        "update": {
          "width": {
            "signal": "width"
          },
          "height": {
            "signal": "mapHeight"
          },
          "fill": {
            "value": "#ffffff"
          }
        }
      },
      "marks": [
        {
          "type": "shape",
          "from": {
            "data": "states"
          },
          "encode": {
            "update": {
              "fill": {
                "value": "#ebe9e5"
              },
              "stroke": {
                "value": "#ffffff"
              },
              "strokeWidth": {
                "value": 1.2
              }
            }
          },
          "transform": [
            {
              "type": "geoshape",
              "projection": "proj"
            }
          ]
        },
        {
          "type": "rule",
          "from": {
            "data": "symbols"
          },
          "encode": {
            "update": {
              "x": {
                "field": "axp"
              },
              "y": {
                "field": "ayp"
              },
              "x2": {
                "field": "x"
              },
              "y2": {
                "field": "y"
              },
              "stroke": {
                "value": "#1d1d1d"
              },
              "strokeWidth": {
                "value": 0.8
              },
              "opacity": {
                "signal": "datum.ax === null ? 0 : 1"
              }
            }
          }
        },
        {
          "type": "symbol",
          "from": {
            "data": "symbols"
          },
          "encode": {
            "update": {
              "x": {
                "field": "x"
              },
              "y": {
                "field": "y"
              },
              "shape": {
                "value": "circle"
              },
              "size": {
                "signal": "pow(2 * datum.r, 2)"
              },
              "fill": {
                "scale": "colour",
                "signal": "datum.row.severe"
              },
              "stroke": {
                "value": "#ffffff"
              },
              "strokeWidth": {
                "value": 1.5
              },
              "tooltip": {
                "signal": "{'State / territory': datum.state, 'Paying over half their income in rent': format(datum.row.severeCount, ','), 'Share of recipients': format(datum.row.severe, '.1f') + '%', 'All rent-assistance recipients': format(datum.row.recipients, ',')}"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "symbols"
          },
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "signal": "datum.inside ? datum.x : datum.x + datum.r + 5"
              },
              "y": {
                "field": "y"
              },
              "align": {
                "signal": "datum.inside ? 'center' : 'left'"
              },
              "baseline": {
                "value": "middle"
              },
              "text": {
                "signal": "[datum.state, format(datum.row.severeCount, ','), format(datum.row.severe, '.0f') + '%']"
              },
              "lineHeight": {
                "signal": "width < 450 ? 13 : 14"
              },
              "fontSize": {
                "signal": "width < 450 ? 11 : 12"
              },
              "fill": {
                "signal": "datum.inside && datum.row.severe >= 15 ? '#ffffff' : '#1d1d1d'"
              },
              "dy": {
                "signal": "width < 450 ? -13 : -14"
              }
            }
          }
        },
        {
          "type": "text",
          "interactive": false,
          "encode": {
            "update": {
              "x": {
                "value": 6
              },
              "y": {
                "signal": "mapHeight - 46"
              },
              "baseline": {
                "value": "top"
              },
              "lineHeight": {
                "value": 15
              },
              "fontSize": {
                "value": 11.5
              },
              "fontWeight": {
                "value": 600
              },
              "fill": {
                "value": "#1d1d1d"
              },
              "text": {
                "value": [
                  "NSW: the most people paying",
                  "over half their income.",
                  "ACT: the highest share, 27%."
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 4
          },
          "y": {
            "signal": "mapHeight + 16"
          },
          "text": {
            "value": [
              "Circle area: people paying",
              "over half their income"
            ]
          },
          "lineHeight": {
            "value": 14
          },
          "fontSize": {
            "value": 11.5
          },
          "fill": {
            "value": "#585858"
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "sizeKey"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "4 + maxRadius"
          },
          "y": {
            "signal": "mapHeight + 44 + 2 * maxRadius - datum.r"
          },
          "shape": {
            "value": "circle"
          },
          "size": {
            "signal": "pow(2 * datum.r, 2)"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#7a7a7a"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "sizeKey"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "8 + 2 * maxRadius"
          },
          "y": {
            "signal": "mapHeight + 44 + 2 * maxRadius - 2 * datum.r"
          },
          "text": {
            "field": "label"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#585858"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width * (width < 450 ? 0.58 : 0.55)"
          },
          "y": {
            "signal": "mapHeight + 16"
          },
          "text": {
            "value": [
              "Colour: their share of",
              "all recipients"
            ]
          },
          "lineHeight": {
            "value": 14
          },
          "fontSize": {
            "value": 11.5
          },
          "fill": {
            "value": "#585858"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "colourKey"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width * (width < 450 ? 0.58 : 0.55)"
          },
          "y": {
            "signal": "mapHeight + 40 + datum.i * 18"
          },
          "width": {
            "value": 12
          },
          "height": {
            "value": 12
          },
          "fill": {
            "scale": "swatch",
            "field": "i"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "colourKey"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width * (width < 450 ? 0.58 : 0.55) + 18"
          },
          "y": {
            "signal": "mapHeight + 46 + datum.i * 18"
          },
          "text": {
            "field": "label"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#585858"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans"
  }
}
